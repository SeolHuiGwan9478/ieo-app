<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 차량 내비(NaviHelper): 남은 거리·시간 조회, 길 안내 요청 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 자동 도착 (WAIT-001): 속도·기어, 위치. 속도와 위치는 처음 켤 때 허락을 받는다 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 차대번호로 이 트럭과 내 차량을 잇는다 (VEH-004) -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- 운행 위치 보내기 (TRIP-013): 내비가 앞에 떠도 GPS를 받도록 운행 중에만 포그라운드 서비스를 켠다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Ieo 서버 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 음성 안내: Pleos 차량의 TTS 엔진(SpeechService)에 연결하는 권한 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 음성 대답 (Pleos SpeechToText SDK). 마이크는 SDK가 차량 서비스로 연다 -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- 음성 안내: 차량의 TTS 엔진을 찾는다 (Android 11부터 필요) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".IeoApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Ieo">

        <!-- 하단 독·런처에서 다시 눌러도 새 창을 만들지 않고 떠 있는 화면으로 돌아온다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 쓸 수 있는 화면으로 선언 (Distraction Optimization) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <service
            android:name=".data.trip.TripLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
